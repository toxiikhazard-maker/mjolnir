# Lokal server
PORT=3000
NODE_ENV=development
SESSION_SECRET=byt-till-en-lang-slumpad-hemlighet
SESSION_MAX_AGE_SECONDS=28800

# Testläge för utveckling. Ska vara false i produktion.
BANKID_MOCK_ENABLED=true
BANKID_MOCK_NAME=Mjölnir Admin
BANKID_MOCK_PERSONAL_NUMBER=199001011234

# Produktion/test mot BankID eller BankID-leverantör.
# Fyll dessa när avtal/certifikat eller leverantörsuppgifter finns.
BANKID_AUTH_URL=
BANKID_COLLECT_URL=
BANKID_CANCEL_URL=
BANKID_ALLOWED_PERSONAL_NUMBERS=

# Använd antingen PFX eller certifikat + nyckel.
BANKID_CLIENT_PFX_PATH=
BANKID_CLIENT_CERT_PASSPHRASE=
BANKID_CLIENT_CERT_PATH=
BANKID_CLIENT_KEY_PATH=
BANKID_CA_CERT_PATH=
